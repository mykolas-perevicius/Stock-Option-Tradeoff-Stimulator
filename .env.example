# Supabase Configuration (OPTIONAL — only needed for the Saved Setups feature)
# Without these, login is disabled but everything else works.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# yfinance Backend URL (real-time market data)
# Production: https://stock-options-backend-62j0.onrender.com
# Local dev:  http://localhost:8000
VITE_YFINANCE_BACKEND_URL=https://stock-options-backend-62j0.onrender.com

# ── Server-only (set in Vercel Project Settings → Environment Variables) ──
# Shared Gemini key powering the AI Interpretation panel for all visitors.
# Get a free key at https://aistudio.google.com/app/apikey
# Without this, AI panel falls back to a local rule-based explanation.
# GEMINI_API_KEY=your-gemini-key

# Optional override for the keepalive cron's target backend
# YFINANCE_BACKEND_URL=https://stock-options-backend-62j0.onrender.com
